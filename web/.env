# ===============================================
# Cấu hình Web Dashboard (DKhoa - G0 v0.1)
# ===============================================

# Cổng khởi chạy Web Dashboard (Mặc định: 5173)
PORT=5173

# Base URL của Backend TDat (Cloud Render)
API_BASE_URL=https://pepper-nursery-iot.onrender.com
VITE_BACKEND_URL=https://pepper-nursery-iot.onrender.com

# Mã thiết bị mặc định
DEFAULT_DEVICE_ID=esp32-nursery-01

# Chế độ dữ liệu mặc định: 'REAL_API'
DATA_MODE=REAL_API

# Chu kỳ tự động làm mới số đo từ Backend (ms)
AUTO_REFRESH_INTERVAL_MS=5000

# Múi giờ hiển thị (Mặc định Giờ Việt Nam GMT+7)
TIMEZONE=Asia/Ho_Chi_Minh
