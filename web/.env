# ===============================================
# Cấu hình Web Dashboard (DKhoa - G0 v0.1)
# ===============================================

# Cổng khởi chạy Web Dashboard (Tránh trùng với Backend: 8000)
PORT=3000

# Base URL của Backend TDat (Đang chạy tại port 8000)
API_BASE_URL=http://localhost:8000

# Mã thiết bị mặc định
DEFAULT_DEVICE_ID=esp32-nursery-01

# Chế độ dữ liệu mặc định: 'REAL_API'
DATA_MODE=REAL_API

# Chu kỳ tự động làm mới số đo từ Backend (ms)
AUTO_REFRESH_INTERVAL_MS=10000

# Múi giờ hiển thị (Mặc định Giờ Việt Nam GMT+7)
TIMEZONE=Asia/Ho_Chi_Minh
