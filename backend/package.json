{
  "name": "pepper-nursery-backend",
  "version": "0.1.0",
  "description": "Backend API & Database for Pepper Nursery IoT MVP (G0 v0.1)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'); if(!fs.existsSync('dist/config')) fs.mkdirSync('dist/config', {recursive:true}); fs.copyFileSync('src/config/rules.config.json', 'dist/config/rules.config.json')\"",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "reset": "tsx src/scripts/reset.ts",
    "test": "tsx test/api.test.ts"
  },
  "keywords": [
    "iot",
    "esp32",
    "backend",
    "pepper-nursery"
  ],
  "author": "TDat",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
